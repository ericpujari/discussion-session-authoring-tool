# Noun Project API credentials (https://api.thenounproject.com).
# Copy to .env for local dev with `vercel dev`, or set as real env vars in
# Vercel project settings for deployment. Never commit real values — .env
# and .env.* are already gitignored.
NOUNPROJECT_API_KEY=
NOUNPROJECT_API_SECRET=

# Redis connection string for draft storage (api/storage.js) — powers
# autosave, resume-by-username, the coach inbox, and sticky notes. Auto-
# injected by Vercel when a Redis database (Storage tab, or Marketplace)
# is connected to this project — see VERCEL_DEPLOYMENT_HANDOFF.md.
REDIS_URL=

# Shared password for the coach review inbox (api/storage.js). Gates the bulk
# `list` operation, which is what stops anyone enumerating every draft. Set this
# by hand in the Vercel project settings — there is no default, and the coach
# inbox stays closed until it exists. Use a long random value; there is
# deliberately no lockout on wrong guesses yet.
COACH_PASSWORD=
