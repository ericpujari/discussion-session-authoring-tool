# Noun Project API credentials (https://api.thenounproject.com).
# Copy to .env for local dev with `vercel dev`, or set as real env vars in
# Vercel project settings for deployment. Never commit real values — .env
# and .env.* are already gitignored.
NOUNPROJECT_API_KEY=
NOUNPROJECT_API_SECRET=

# Redis connection string. Powers draft storage (api/storage.js — autosave,
# resume-by-username, the coach inbox, sticky notes) and, if set, also enables
# icon-search caching/rate-limiting and the icon-embed cache below
# (api/noun-project-search.js, api/icon-asset.js) — both degrade gracefully
# without it, just with no caching/quota protection. Auto-injected by Vercel
# when a Redis database (Storage tab, or Marketplace) is connected to this
# project — see VERCEL_DEPLOYMENT_HANDOFF.md.
REDIS_URL=

# Shared password for the coach review inbox (api/storage.js). Gates the bulk
# `list` operation, which is what stops anyone enumerating every draft. Set this
# by hand in the Vercel project settings — there is no default, and the coach
# inbox stays closed until it exists. Use a long random value; there is
# deliberately no lockout on wrong guesses yet.
COACH_PASSWORD=

# Daily quota guards for Noun Project (api/noun-project-search.js's search-call
# budget, api/icon-asset.js's icon-call budget) — checked 2026-09 against Noun
# Project's own pricing page: the Free Trial this project is on allows 1,000
# "service calls" (searches) and 150 "icon calls" (by-id lookups, one per icon a
# writer actually selects) per day; Pay-Per-Use allows 200,000 and 10,000/day.
# Defaults below leave headroom under the Free Trial's tighter ceiling — raise
# both once the project moves to a paid plan, or this will refuse icon search
# well before the real limit is reached. Optional: only take effect if REDIS_URL
# is also set, since the budget counters live in Redis.
NOUNPROJECT_DAILY_SERVICE_BUDGET=900
NOUNPROJECT_DAILY_ICON_BUDGET=130
